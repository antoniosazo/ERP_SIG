# Base de plataforma: firmas, cuentas de usuario y registro de la base de cada firma.
# Local (pnpm db:local start): postgres://postgres:postgres@localhost:54320/erp_plataforma
# Neon: postgresql://<usuario>:<password>@<host>.neon.tech/<base>?sslmode=require
PLATAFORMA_DATABASE_URL=

# Dónde se crean las bases de las firmas nuevas: "neon" (un proyecto Neon por firma) o
# "servidor" (una base por firma en FIRMAS_DATABASE_URL; desarrollo y pruebas).
FIRMAS_PROVEEDOR=

# Neon (FIRMAS_PROVEEDOR=neon): API key con permiso para crear proyectos, ID de la organización
# (formato org-…, no su nombre) y región por defecto. La key solo debe existir en el servidor.
# Los proyectos de firmas dadas de baja se borran a mano en la consola de Neon.
NEON_API_KEY=
NEON_ORG_ID=
NEON_REGION=aws-sa-east-1

# Servidor propio (FIRMAS_PROVEEDOR=servidor): debe poder ejecutar CREATE DATABASE.
# Local: postgres://postgres:postgres@localhost:54320/postgres
FIRMAS_DATABASE_URL=

# Clave AES-256 para cifrar la conexión de cada firma en la base de plataforma (32 bytes en
# base64). Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, las conexiones de Neon se recuperan desde su API.
FIRMAS_CONEXION_KEY=

# Conexiones máximas por firma en cada instancia de la app (opcional, por defecto 5).
FIRMAS_DB_POOL_MAX=

# Clave de firma de sesión de Auth.js (32+ bytes aleatorios). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Clave AES-256 para cifrar las credenciales del SII (exactamente 32 bytes en base64).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, hay que recargar las credenciales del SII de cada empresa.
SII_ENCRYPTION_KEY=

# Poner en 1 para usar el cliente SII de prueba (no llama a sii.cl). Solo desarrollo.
SII_USAR_MOCK=

# Secreto de la tarea horaria que baja los XML del SII a la bandeja (GET /api/cron/sii-xml
# con el header "Authorization: Bearer <secreto>"). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
