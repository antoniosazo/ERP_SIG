# Connection string de Neon (Postgres). Formato esperado:
# postgresql://<usuario>:<password>@<host>.neon.tech/<database>?sslmode=require
DATABASE_URL=

# Clave de firma de sesión de Auth.js (32+ bytes aleatorios). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
