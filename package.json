{
  "name": "erp-contable",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @erp/db db:generate",
    "db:migrate": "pnpm --filter @erp/db db:migrate",
    "db:seed": "pnpm --filter @erp/db db:seed",
    "db:studio": "pnpm --filter @erp/db db:studio",
    "bootstrap-firma": "pnpm --filter @erp/db bootstrap-firma"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver", "sharp"]
  }
}
